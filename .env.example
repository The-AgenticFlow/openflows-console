# OpenFlows Console environment example.
# Base URL of OpenFlows Manager. The Console proxies /api/v1 and /auth to it so
# the browser holds Manager's own session cookies on the Console's origin.
OPENFLOWS_MANAGER_URL=http://127.0.0.1:3002

# Optional sign-in page footer links. Leave unset to hide a link.
# OPENFLOWS_SUPPORT_URL may be mailto:support@example.com.
# OPENFLOWS_DOCS_URL=https://docs.example.com
# OPENFLOWS_STATUS_URL=https://status.example.com
# OPENFLOWS_PRIVACY_URL=https://example.com/privacy
# OPENFLOWS_TERMS_URL=https://example.com/terms
# OPENFLOWS_SUPPORT_URL=mailto:support@example.com
